# Environment Variables Example for JalDrishti

# General
ENVIRONMENT=development
DEMO_MODE=true
SECRET_KEY=replace-with-a-secure-secret-key

# Backend Config
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database (Default: SQLite for local dev)
DATABASE_URL=sqlite:///./jaldrishti.db
# PostgreSQL / PostGIS fallback example:
# DATABASE_URL=postgresql://user:password@localhost:5432/jaldrishti

# External APIs (Optional - fallback to DEMO MODE if omitted)
IMD_API_KEY=
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
